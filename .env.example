# GEMINI_API_KEY: Required for Gemini AI API calls and Google Search Grounding.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Config (VITE_ prefix so Vite embeds them in the client build).
# Set these in Netlify env vars for production; locally they fall back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="YOUR_OAUTH_CLIENT_ID"

# Search provider API keys (optional)
BRAVE_SEARCH_API_KEY=""
SERPER_API_KEY=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# APP_URL: Public URL for OAuth callbacks.
APP_URL="MY_APP_URL"
